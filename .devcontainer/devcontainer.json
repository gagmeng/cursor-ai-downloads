{
  "name": "TypeScript + Bun Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "oven.bun-vscode"
      ]
    }
  },
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash && ~/.bun/bin/bun install",
  "remoteUser": "node"
}
